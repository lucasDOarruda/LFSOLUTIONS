# Copy to .env and fill in. Never commit the real .env file.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered (comma-separate for multiple inboxes).
EMAIL_TO=fogacaluciana10@gmail.com

# Sender address. Must be on a domain verified in Resend for customer
# acknowledgement emails to be delivered. While testing you can leave this unset
# to use onboarding@resend.dev, which only delivers to the Resend account owner.
EMAIL_FROM="LDF Solutions <support@your-domain.com>"
